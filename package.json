{
  "name": "share_confessions",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "publish:android": "eas build --platform android --profile preview",
    "update:app": "eas update --branch preview && npx sentry-expo-upload-sourcemaps dist",
    "upgrade": "bun install expo@latest && bunx expo install --fix",
    "android": "bunx expo run:android --device",
    "release:android": "bunx expo run:android --device --variant Release",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" && prettier --check \"src/**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix && prettier --write \"src/**/*.{js,jsx,ts,tsx,json}\"",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.10.3",
    "@expo/vector-icons": "^14.0.2",
    "@hookform/resolvers": "^5.0.1",
    "@react-native-community/netinfo": "11.4.1",
    "@sentry/react-native": "^6.12.0",
    "@shopify/flash-list": "1.7.6",
    "convex": "^1.23.0",
    "date-fns": "^4.1.0",
    "expo": "^53.0.1",
    "expo-constants": "~17.1.3",
    "expo-device": "~7.1.3",
    "expo-font": "~13.2.2",
    "expo-linking": "~7.1.3",
    "expo-notifications": "~0.31.0",
    "expo-quick-actions": "^4.0.2",
    "expo-router": "~5.0.3",
    "expo-secure-store": "~14.2.2",
    "expo-splash-screen": "~0.30.6",
    "expo-system-ui": "~5.0.5",
    "expo-updates": "~0.28.9",
    "expo-web-browser": "~14.1.5",
    "react": "19.0.0",
    "react-hook-form": "^7.56.1",
    "react-native": "0.79.1",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-nitro-modules": "^0.25.2",
    "react-native-reanimated": "~3.17.4",
    "react-native-ruler-picker": "^0.2.2",
    "react-native-safe-area-context": "5.3.0",
    "react-native-screens": "~4.10.0",
    "react-native-toast-message": "^2.2.0",
    "react-native-unistyles": "^3.0.0-beta.8",
    "svix": "^1.64.1",
    "zod": "^3.24.3",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.9",
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "eslint-config-expo": "^8.0.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-config-universe": "^12.1.0",
    "eslint-plugin-hooks": "^0.4.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "prettier": "^3.5.3",
    "typescript": "~5.8.3"
  },
  "private": true,
  "trustedDependencies": [
    "@clerk/shared",
    "@sentry/cli",
    "browser-tabs-lock",
    "core-js",
    "esbuild",
    "react-native-nitro-modules",
    "unrs-resolver"
  ],
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": true,
        "exclude": [
          "convex",
          "@hookform/resolvers"
        ],
        "listUnknownPackages": true
      }
    }
  }
}
